# HTTP
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Database
DATABASE_URL=postgresql://rbac:rbac@localhost:5432/rbac?schema=public

# Tokens
JWT_ACCESS_SECRET=change-me-in-production-please
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false

# Account security
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
LOGIN_RATE_LIMIT_PER_MINUTE=20

# Exposes the demo accounts list on the login page (never enable in production)
DEMO_MODE=true
